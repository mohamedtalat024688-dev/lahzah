# ==============================================================================
# Lahzah (لحظة) - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Local Development (Zero-friction SQLite):
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (Supabase, Neon, AWS RDS, Railway):
# DATABASE_URL="postgresql://user:password@host:5432/lahzah?schema=public&sslmode=require"

# ------------------------------------------------------------------------------
# 2. Authentication & Sessions
# ------------------------------------------------------------------------------
# Secure 256-bit secret key for signing JWT cookies
JWT_SECRET="lahzah-super-secret-jwt-key-2026-very-secure-replace-in-prod"

# App Public Domain (Used for generating absolute QR codes and WhatsApp share URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Object Storage Architecture (Local vs S3-compatible Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
# Provider choice: "local" (default for development) or "s3" (for production)
STORAGE_PROVIDER="local"

# When STORAGE_PROVIDER="s3":
# S3_BUCKET_NAME="lahzah-uploads"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="your-access-key-id"
# S3_SECRET_ACCESS_KEY="your-secret-access-key"
# Optional for Cloudflare R2 / MinIO:
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# Optional Public CDN or custom domain for assets:
# S3_PUBLIC_DOMAIN="https://cdn.lahzah.com"

# ------------------------------------------------------------------------------
# 4. Payment Gateway Architecture (Simulation vs Paymob Egypt)
# ------------------------------------------------------------------------------
# Provider choice: "simulation" (default for dev/testing) or "paymob" (production)
PAYMENT_PROVIDER="simulation"

# When PAYMENT_PROVIDER="paymob":
# PAYMOB_API_KEY="your_paymob_api_key"
# PAYMOB_INTEGRATION_ID="your_card_integration_id"
# PAYMOB_IFRAME_ID="your_paymob_iframe_id"
# PAYMOB_HMAC_SECRET="your_paymob_hmac_secret"
