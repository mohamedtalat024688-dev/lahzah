// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("OWNER") // OWNER or ADMIN
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  events       Event[]
}

model Event {
  id              String      @id @default(uuid())
  slug            String      @unique
  title           String
  eventType       String      @default("WEDDING") // WEDDING, ENGAGEMENT, BIRTHDAY, etc.
  groomName       String
  brideName       String
  eventDate       DateTime
  venueName       String
  address         String
  mapUrl          String?
  description     String?
  welcomeMessage  String?     @default("يسعدنا ويشرفنا حضوركم ومشاركتنا فرحتنا")
  coverImage      String?
  templateId      String      @default("royal-gold")
  isPublished     Boolean     @default(false)
  isPaid          Boolean     @default(false)
  packageTier     String      @default("BASIC") // BASIC, PREMIUM, LUXURY
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rsvps           Rsvp[]
  photos          Photo[]
  payments        PaymentTransaction[]
  guestInvites    GuestInvite[]

  // Master Template Architecture & Structured Extensibility (Phase 1)
  sectionsConfig  String?     // JSON string: sections order & enabled status [{ id, enabled, order }]
  scheduleItems   String?     // JSON string: day schedule itinerary [{ id, time, title, description, location, icon }]
  dressCode       String?     // JSON string: dress code guidance { title, description, preferredColors, prohibitedColors, imageUrl }
  couplePhotos    String?     // JSON string: pre-event couple gallery photos [{ id, url, caption, order, isCover }]
  musicConfig     String?     // JSON string: background music settings { enabled, trackUrl, title, allowAutoplay }
  defaultMaxSeats Int         @default(3) // Default max accompanying guests per open RSVP submission

  @@index([slug])
  @@index([userId])
}

model Rsvp {
  id               String        @id @default(uuid())
  eventId          String
  guestName        String
  phone            String?
  attendanceStatus String        // ATTENDING, NOT_ATTENDING, MAYBE
  guestCount       Int           @default(1)
  note             String?
  createdAt        DateTime      @default(now())
  event            Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestInvite      GuestInvite?

  @@index([eventId])
  @@index([eventId, attendanceStatus])
  @@index([eventId, createdAt])
}

model GuestInvite {
  id         String    @id @default(uuid())
  eventId    String
  token      String    @unique
  guestName  String
  phone      String?
  maxSeats   Int       @default(2)
  isUsed     Boolean   @default(false)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsvpId     String?   @unique
  rsvp       Rsvp?     @relation(fields: [rsvpId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([token])
  @@index([eventId, isUsed])
}

model Photo {
  id          String   @id @default(uuid())
  eventId     String
  url         String
  guestName   String?  @default("ضيف عزيز")
  message     String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
  @@index([eventId, status])
  @@index([eventId, createdAt])
}

model Package {
  id          String   @id @default(uuid())
  code        String   @unique // BASIC, PREMIUM, LUXURY
  nameAr      String
  nameEn      String
  price       Float
  currency    String   @default("EGP")
  photoLimit  Int      @default(100)
  features    String   // JSON string of feature keys
  isPopular   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model PaymentTransaction {
  id            String   @id @default(uuid())
  eventId       String
  packageCode   String   // BASIC, PREMIUM, LUXURY
  amount        Float
  currency      String   @default("EGP")
  status        String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  provider      String   @default("SIMULATION") // SIMULATION, PAYMOB, FAWRY, STRIPE
  providerTxnId String?  @unique
  metadata      String?  // JSON string
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
  @@index([providerTxnId])
}

